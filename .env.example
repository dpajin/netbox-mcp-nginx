# Copy to .env and fill in. Never commit .env.

# netbox configuration
NETBOX_URL=https://netbox.example.com/
NETBOX_TOKEN=
# Clients send "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# enable netbox plugin discovery
ENABLE_PLUGIN_DISCOVERY=true
# Optional
# MCP_IMAGE_TAG=latest   # pin to a release, e.g. 1.2.2
# VERIFY_SSL=true        # NetBox TLS verification
# LOG_LEVEL=INFO

# External HTTPS port on nginx
HTTPS_PORT=9999
